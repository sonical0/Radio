<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- Poser une alarme exacte. USE_EXACT_ALARM est réservée aux applications
       dont le réveil est une fonction principale, ce qui est le cas ici ;
       SCHEDULE_EXACT_ALARM couvre Android 12, où elle est révocable. -->
  <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
  <uses-permission
    android:name="android.permission.SCHEDULE_EXACT_ALARM"
    android:maxSdkVersion="32" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <!-- Sans elle, toutes les alarmes disparaîtraient au redémarrage, en silence. -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Accordée d'office aux applications de réveil et d'appel depuis Android 14. -->
  <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

  <application>
    <!-- showWhenLocked + turnScreenOn : la fenêtre s'ouvre par-dessus le
         verrouillage et allume l'écran. excludeFromRecents : un écran de
         réveil n'a rien à faire dans le sélecteur d'applications une fois
         la sonnerie finie. noHistory : il ne survit pas à sa fermeture. -->
    <activity
      android:name=".AlarmActivity"
      android:exported="false"
      android:showWhenLocked="true"
      android:turnScreenOn="true"
      android:excludeFromRecents="true"
      android:noHistory="true"
      android:launchMode="singleTask"
      android:taskAffinity=""
      android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen" />

    <service
      android:name=".AlarmService"
      android:exported="false"
      android:foregroundServiceType="mediaPlayback" />

    <receiver
      android:name=".AlarmReceiver"
      android:exported="false" />

    <!-- Exporté : la diffusion vient du système, pas de l'application. C'est
         une diffusion protégée, qu'aucune autre application ne peut émettre. -->
    <receiver
      android:name=".BootReceiver"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
