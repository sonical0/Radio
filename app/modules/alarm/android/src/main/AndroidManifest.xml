<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- Poser une alarme exacte. USE_EXACT_ALARM est réservée aux applications
       dont le réveil est une fonction principale, ce qui est le cas ici ;
       SCHEDULE_EXACT_ALARM couvre Android 12, où elle est révocable. -->
  <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
  <uses-permission
    android:name="android.permission.SCHEDULE_EXACT_ALARM"
    android:maxSdkVersion="32" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <!-- Sans elle, toutes les alarmes disparaîtraient au redémarrage, en silence. -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <application>
    <service
      android:name=".AlarmService"
      android:exported="false"
      android:foregroundServiceType="mediaPlayback" />

    <receiver
      android:name=".AlarmReceiver"
      android:exported="false" />

    <!-- Exporté : la diffusion vient du système, pas de l'application. C'est
         une diffusion protégée, qu'aucune autre application ne peut émettre. -->
    <receiver
      android:name=".BootReceiver"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
